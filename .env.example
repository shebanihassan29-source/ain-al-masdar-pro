# Local development:  cp .env.example .env  &&  npm run dev
NODE_ENV=development
PORT=3000
JWT_SECRET=change-me-to-a-long-random-string
ADMIN_KEY=change-me-admin-password
# Permanent secret for licence fingerprints (leak tracing). Set once, never rotate.
WATERMARK_SALT=change-me-permanent-watermark-secret
# Leave empty locally to use the JSON-file store (dev only). Required in production.
DATABASE_URL=
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
AI_DAILY_LIMIT=40
AI_TRANSLATE_DAILY_LIMIT=200
PRO_PRICE=30
PRO_CURRENCY=د.ل
PRO_PERIOD_DAYS=30
TRIAL_DAYS=0
PAYMENT_INSTRUCTIONS=
# Shown to subscribers (WhatsApp number or e-mail) for support / payment confirmation
SUPPORT_CONTACT=
FREE_APP_URL=https://shebanihassan29-source.github.io/ain-al-masdar/
